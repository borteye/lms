{
  "extends": "@workspace/typescript-config/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@workspace/ui/*": ["../../packages/ui/src/*"],
      "@workspace/common/*": ["../../packages/common/src/*"],
      "@workspace/assets/*": ["../../packages/assets/*"],
      "@workspace/auth/*": ["../../packages/auth/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
, "../../packages/common/src/components/app-sidebar.tsx", "../../packages/common/src/lib/loops.ts"  ],
  "exclude": ["node_modules"]
}
